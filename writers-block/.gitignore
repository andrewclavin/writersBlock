# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
app-example

# generated native folders
/ios
/android

# Gutenberg source texts (commit public-domain texts)
#
# NOTE: We DO commit `books/books-src/*.txt` for public-domain books.
# We keep specific copyrighted texts local-only via the ignores below.

# Local-only copyrighted raw texts (never commit/sync)
books/books-src/old-man-and-the-sea.txt
books/books-src/old-man-and-the-sea*.txt

# Local-only copyrighted derived outputs (never commit/sync)
books/old-man-and-the-sea/

# Local-only copyrighted book config (never commit/sync)
src/config/old-man-and-the-sea.config.js

# Web-only prepared book assets (generated/copy from `books/`).
# These are fetched + cached at runtime for offline use.
public/books/
